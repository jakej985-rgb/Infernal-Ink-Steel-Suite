<UserControl x:Class="InfernalInkSteelSuite.UI.Views.Settings.UserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.UI.Views.Settings"
             xmlns:attachedProperties="clr-namespace:InfernalInkSteelSuite.UI.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Enhanced Profile Section -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Profile" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Border Grid.Column="0" Width="100" Height="100" CornerRadius="50" Margin="0,0,20,0" 
                            Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2">
                        <Image Source="{Binding AvatarPath, TargetNullValue={x:Null}}" Stretch="UniformToFill">
                            <Image.Clip>
                                <EllipseGeometry Center="50,50" RadiusX="48" RadiusY="48"/>
                            </Image.Clip>
                        </Image>
                    </Border>

                    <!-- Profile Info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Username}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <Border Background="{DynamicResource PrimaryBrush}" CornerRadius="3" Padding="5,2">
                                <TextBlock Text="{Binding Role}" FontSize="12" Foreground="White" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Text="{Binding Department, StringFormat='• {0}'}" FontSize="14" Foreground="{DynamicResource TextColor}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Content="Change Avatar" Command="{Binding OpenChangeAvatarDialogCommand}" 
                                HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Font Size Adjustment -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔤" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Font Size" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="Small" FontSize="10" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Minimum="10" Maximum="20" Value="{Binding FontSize}" 
                                TickFrequency="2" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="XL" FontSize="20" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </Grid>
                    <TextBlock Text="{Binding FontSizeLabel, StringFormat='Current Size: {0}'}" 
                               FontSize="14" Foreground="{DynamicResource TextColor}" Margin="0,10,0,10" HorizontalAlignment="Center"/>
                    <Button Content="Save Font Size" Command="{Binding SaveFontSizeCommand}" 
                            HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Expander>

            <!-- Appearance & Theme -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🎨" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Appearance &amp; Theme" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <Label Content="Select Theme" Foreground="{DynamicResource TextColor}" FontWeight="Medium"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" 
                              DisplayMemberPath="DisplayName" Margin="0,0,0,10"/>
                    <CheckBox Content="Enable Automatic Holiday Themes" IsChecked="{Binding EnableAutomaticHolidayThemes}" 
                              Foreground="{DynamicResource TextColor}" Margin="0,0,0,20"/>

                    <!-- Expanded Theme Preview -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" 
                            BorderThickness="2" CornerRadius="5" Padding="20">
                        <StackPanel>
                            <Label Content="Theme Preview" FontWeight="Bold" Foreground="{DynamicResource TextColor}" 
                                   HorizontalAlignment="Center" FontSize="16" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="20"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left Column -->
                                <StackPanel Grid.Column="0">
                                    <Label Content="Text Elements" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                                    <TextBlock Text="This is a normal text block" Foreground="{DynamicResource TextColor}" Margin="0,5"/>
                                    <TextBlock Text="This is emphasized text" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,5"/>
                                    
                                    <Label Content="Input Elements" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                                    <TextBox Text="Sample text input" Margin="0,5"/>
                                    <ComboBox Margin="0,5">
                                        <ComboBoxItem Content="Option 1" IsSelected="True"/>
                                        <ComboBoxItem Content="Option 2"/>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Right Column -->
                                <StackPanel Grid.Column="2">
                                    <Label Content="Buttons" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                                    <Button Content="Primary Button" Style="{StaticResource PrimaryButtonStyle}" Margin="0,5"/>
                                    <Button Content="Outlined Button" Margin="0,5"/>
                                    <Button Content="Disabled Button" IsEnabled="False" Margin="0,5"/>
                                    
                                    <Label Content="Selection" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                                    <CheckBox Content="Checked checkbox" IsChecked="True" Foreground="{DynamicResource TextColor}" Margin="0,5"/>
                                    <CheckBox Content="Unchecked checkbox" IsChecked="False" Foreground="{DynamicResource TextColor}" Margin="0,5"/>
                                    <RadioButton Content="Selected option" IsChecked="True" Foreground="{DynamicResource TextColor}" Margin="0,5"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Security -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Security" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <Button Content="Change Password" Command="{Binding OpenChangePasswordDialogCommand}" 
                            HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"/>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
