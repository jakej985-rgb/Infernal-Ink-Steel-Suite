<Window x:Class="InfernalInkSteelSuite.UI.Views.Settings.ResetPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:attachedProperties="clr-namespace:InfernalInkSteelSuite.UI.AttachedProperties"
        Title="Reset Password" Height="200" Width="400"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="New Password"/>
            <controls:PasswordBoxWithToggle Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" xmlns:controls="clr-namespace:InfernalInkSteelSuite.UI.Controls"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="OK" IsDefault="True" Click="Ok_Click" MinWidth="80"/>
                <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
