<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subtle Father's Day Palette -->
    <Color x:Key="AppBackgroundColor">#FFf0f2f5</Color>   <!-- Light Gray -->
    <Color x:Key="SurfaceColor">#FFe4e6eb</Color>       <!-- Silver -->
    <Color x:Key="SurfaceAltColor">#FFccd0d5</Color>      <!-- Light Steel -->

    <Color x:Key="PrimaryColor">#FF4a6fa5</Color>        <!-- Steel Blue -->
    <Color x:Key="PrimaryHoverColor">#FF6b8bbf</Color>   <!-- Lighter Steel Blue -->
    <Color x:Key="PrimaryPressedColor">#FF3b5a8a</Color>  <!-- Darker Steel Blue -->

    <Color x:Key="AccentColor">#FF8a5a3a</Color>         <!-- Sienna -->
    <Color x:Key="DangerColor">#FFc0392b</Color>

    <Color x:Key="PrimaryTextColor">#FF1c2833</Color>     <!-- Dark Charcoal -->
    <Color x:Key="SecondaryTextColor">#FF34495e</Color>   <!-- Wet Asphalt -->
    <Color x:Key="MutedTextColor">#FF7f8c8d</Color>      <!-- Grayish -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1AFFFFFF"/>

    <!-- Holiday Asset -->
    <ImageBrush x:Key="HolidayImageBrush" ImageSource="/Assets/Images/fathersday.png" Stretch="Uniform" />

    <!-- Window background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource AppBackgroundColor}" />

</ResourceDictionary>
