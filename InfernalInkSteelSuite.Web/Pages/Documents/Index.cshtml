@page
@model InfernalInkSteelSuite.Web.Pages.Documents.IndexModel
@{
    ViewData["Title"] = "Documents";
}

<section class="documents-page">
    <header class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1>Documents</h1>
        <!-- Upload button could go here if we implemented upload form -->
    </header>

    @if (Model.Documents.Count == 0)
    {
        <div class="text-center py-5 text-muted border rounded border-secondary bg-surface">
            <h4>No documents found.</h4>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0 text-white">
                <thead>
                    <tr>
                        <th class="border-secondary">Title</th>
                        <th class="border-secondary">Date</th>
                        <th class="border-secondary text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doc in Model.Documents)
                    {
                        <tr class="align-middle">
                            <td class="border-secondary">
                                <span class="fw-bold">@doc.Title</span>
                            </td>
                            <td class="border-secondary">@doc.CreatedAt.ToString("g")</td>
                            <td class="border-secondary text-end">
                                <!-- Download/View links would go here if file paths were accessible/served -->
                                <button class="btn btn-sm btn-outline-secondary" disabled>Download</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
