@page
@model InfernalInkSteelSuite.Web.Pages.Documents.IndexModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Documents";
}

<h2>Documents</h2>

<!-- Upload Form (Collapsible or just explicit for now, keeping it explicit as per plan) -->
<div class="card bg-dark border-secondary mb-4">
    <div class="card-header border-secondary">
        <h5 class="m-0">Upload New Document</h5>
    </div>
    <div class="card-body">
        <form method="post" enctype="multipart/form-data" asp-controller="Documents" asp-action="Upload"
            class="row g-3">
            <div class="col-md-3">
                <label for="clientId" class="form-label">Client ID</label>
                <input type="number" class="form-control bg-dark text-white border-secondary" id="clientId"
                    name="clientId" required placeholder="e.g. 1">
            </div>
            <div class="col-md-4">
                <label for="title" class="form-label">Title</label>
                <input type="text" class="form-control bg-dark text-white border-secondary" id="title" name="title"
                    placeholder="Document Title (Optional)">
            </div>
            <div class="col-md-3">
                <label for="file" class="form-label">File</label>
                <input type="file" class="form-control bg-dark text-white border-secondary" id="file" name="file"
                    required>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-accent w-100">Upload</button>
            </div>
        </form>
    </div>
</div>

<div class="card bg-dark border-secondary">
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover m-0 align-middle">
            <thead class="text-secondary text-uppercase small">
                <tr>
                    <th scope="col" class="ps-3">Title</th>
                    <th scope="col">Client ID</th>
                    <th scope="col">Uploaded By</th>
                    <th scope="col">Created</th>
                    <th scope="col" class="text-end pe-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Documents.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">No documents found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var d in Model.Documents)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-white">@d.Title</td>
                            <td><span class="badge bg-secondary">#@d.ClientId</span></td>
                            <td>User #@d.UploadedByUserId</td>
                            <td>@d.CreatedAt.ToLocalTime().ToString("g")</td>
                            <td class="text-end pe-3">
                                <a href="#" class="btn btn-sm btn-outline-light disabled">Download</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
