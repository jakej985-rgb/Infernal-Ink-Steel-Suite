@page
@model InfernalInkSteelSuite.Web.Pages.Clients.DocumentsModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Client Documents";
    var apiBase = Configuration["ApiBaseUrl"] ?? "";
}

<h2>Documents for @Model.Client?.FirstName @Model.Client?.LastName</h2>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<h3>Upload new document / ID scan</h3>

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="ClientId" />
    <div class="form-group">
        <label asp-for="Title">Title (optional)</label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="UploadFile">File</label>
        <input asp-for="UploadFile" type="file" class="form-control" />
        <span asp-validation-for="UploadFile" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

<hr />

<h3>Existing documents</h3>

@if (Model.Documents.Count == 0)
{
    <p>No documents uploaded yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Uploaded</th>
            <th>Download</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var d in Model.Documents)
        {
            <tr>
                <td>@d.Title</td>
                <td>@d.CreatedAt.ToLocalTime()</td>
                <td>
                    <a href="@($"{apiBase}/documents/{d.Id}/download")" target="_blank">
                        Download
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
