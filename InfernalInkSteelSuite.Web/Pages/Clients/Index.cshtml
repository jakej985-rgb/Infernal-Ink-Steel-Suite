@page
@model InfernalInkSteelSuite.Web.Pages.Clients.IndexModel
@{
    ViewData["Title"] = "Clients";
}

<section class="clients-page">
    <header class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1>Clients</h1>
        <div class="d-flex gap-2">
            <a asp-page="/Clients/Edit" class="btn btn-primary d-flex align-items-center gap-2">
                <span>+ New Client</span>
            </a>
        </div>
    </header>

    <div class="row mb-4">
        <div class="col-md-6">
            <form method="get" class="d-flex clients-search-form gap-2">
                <input type="text" name="Search" value="@Model.Search" placeholder="Search by name, phone, or email..." class="form-control" />
                <button type="submit" class="btn btn-outline-light">Search</button>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover table-striped mb-0 text-white">
                    <thead class="bg-dark">
                        <tr>
                            <th class="border-secondary">Name</th>
                            <th class="border-secondary">Phone</th>
                            <th class="border-secondary">Email</th>
                            <th class="border-secondary text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Clients.Count == 0)
                        {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No clients found.</td>
                                </tr>
                        }
                        else
                        {
                            @foreach (var c in Model.Clients)
                            {
                                        <tr class="align-middle">
                                            <td class="border-secondary">
                                                <div class="fw-bold">@c.FullName</div>
                                            </td>
                                            <td class="border-secondary">
                                        @if (!string.IsNullOrEmpty(c.Phone))
                                        {
                                                        <span>@c.Phone</span>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">-</span>
                                        }
                                            </td>
                                            <td class="border-secondary">
                                        @if (!string.IsNullOrEmpty(c.Email))
                                        {
                                                        <a href="mailto:@c.Email" class="text-decoration-none">@c.Email</a>
                                        }
                                        else
                                        {
                                                        <span class="text-muted">-</span>
                                        }
                                            </td>
                                            <td class="border-secondary text-end">
                                                <a asp-page="/Clients/Edit" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">
                                                    Edit
                                                </a>
                                            </td>
                                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
