@page "{id:int?}"
@model InfernalInkSteelSuite.Web.Pages.Clients.EditModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <form method="post">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1>@Model.Title</h1>
                <div class="btn-group">
                    <a asp-page="/Clients/Index" class="btn btn-outline-light">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Client</button>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger">@Model.ErrorMessage</div>
            }

            <div class="card mb-4">
                <div class="card-header bg-transparent border-secondary">
                    <h5 class="mb-0">Client Information</h5>
                </div>
                <div class="card-body">
                    <input type="hidden" asp-for="Client.Id" />

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="Client.FirstName" class="form-label">First Name</label>
                            <input asp-for="Client.FirstName" class="form-control" required />
                            <span asp-validation-for="Client.FirstName" class="text-warning"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Client.MiddleName" class="form-label">Middle Name</label>
                            <input asp-for="Client.MiddleName" class="form-control" />
                            <span asp-validation-for="Client.MiddleName" class="text-warning"></span>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="Client.LastName" class="form-label">Last Name</label>
                            <input asp-for="Client.LastName" class="form-control" required />
                            <span asp-validation-for="Client.LastName" class="text-warning"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Client.Phone" class="form-label">Phone</label>
                            <input asp-for="Client.Phone" class="form-control" />
                            <span asp-validation-for="Client.Phone" class="text-warning"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Client.Email" class="form-label">Email</label>
                            <input asp-for="Client.Email" type="email" class="form-control" />
                            <span asp-validation-for="Client.Email" class="text-warning"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header bg-transparent border-secondary">
                    <h5 class="mb-0">Additional Details</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="Client.Notes" class="form-label">Notes</label>
                        <textarea asp-for="Client.Notes" class="form-control" rows="5"></textarea>
                        <span asp-validation-for="Client.Notes" class="text-warning"></span>
                    </div>
                </div>
            </div>
        </form>

        @if (Model.Client.Id > 0)
        {
            <div class="card mb-4">
                <div class="card-header bg-transparent border-secondary d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Documents</h5>
                    <span class="badge bg-secondary">@Model.Documents.Count</span>
                </div>
                <div class="card-body">
                    @if (Model.Documents.Count > 0)
                    {
                        <div class="list-group list-group-flush mb-3">
                            @foreach (var doc in Model.Documents)
                            {
                                <div class="list-group-item bg-transparent text-white d-flex justify-content-between align-items-center border-secondary">
                                    <div>
                                        <i class="bi bi-file-earmark-text me-2 text-accent"></i>
                                        <strong>@doc.Title</strong>
                                        <div class="small text-muted">Uploaded: @doc.CreatedAt.ToString("g")</div>
                                    </div>
                                    <button class="btn btn-sm btn-outline-light" disabled>Download</button>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted small mb-3">No documents uploaded.</p>
                    }

                    <hr class="border-secondary" />

                    <form method="post" enctype="multipart/form-data" asp-page-handler="Upload">
                        <input type="hidden" asp-for="Client.Id" />
                        <label class="form-label small text-uppercase fw-bold text-accent">Upload New Document</label>
                        <div class="input-group mb-2">
                            <input asp-for="UploadTitle" class="form-control" placeholder="Document Title (Optional)" />
                            <input asp-for="Upload" class="form-control" type="file" required />
                            <button class="btn btn-primary" type="submit">Upload</button>
                        </div>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
