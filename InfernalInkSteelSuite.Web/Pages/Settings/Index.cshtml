@page
@model InfernalInkSteelSuite.Web.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    Layout = "_DashboardLayout";
}

<h1 class="mb-4">Settings</h1>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">Desktop App Connection</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Use these details to link your Desktop Application to this Web Portal.</p>
                
                <div class="mb-3">
                    <label class="form-label">Web Portal URL</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="@Request.Scheme://@Request.Host" readonly>
                        <button class="btn btn-outline-secondary" type="button">Copy</button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label">API Key</label>
                    <div class="input-group">
                        <input type="text" class="form-control" value="IIS-7X92-K3M1-P99L" readonly> <!-- Placeholder Key -->
                        <button class="btn btn-outline-secondary" type="button">Copy</button>
                    </div>
                    <div class="form-text">Enter this key in the Desktop App under Settings > Integrations.</div>
                </div>
            </div>
        </div>
    </div>
</div>
