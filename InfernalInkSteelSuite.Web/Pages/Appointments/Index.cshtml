@page
@model InfernalInkSteelSuite.Web.Pages.Appointments.IndexModel
@{
    ViewData["Title"] = "Appointments";
    var prevDate = Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd");
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var currentStr = Model.SelectedDate.ToString("yyyy-MM-dd");
}

<section class="appointments-page">
    <header class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1>Appointments</h1>
        <div class="d-flex gap-2">
            <a asp-page="/Appointments/Edit" class="btn btn-primary d-flex align-items-center gap-2">
                <span>+ New Appointment</span>
            </a>
        </div>
    </header>

    <div class="d-flex justify-content-between align-items-center bg-dark p-3 rounded mb-4 border border-secondary">
        <div class="btn-group">
            <a asp-page="./Index" asp-route-Date="@prevDate" class="btn btn-outline-light">&larr; Prev</a>
            <a asp-page="./Index" asp-route-Date="@today" class="btn btn-outline-light">Today</a>
            <a asp-page="./Index" asp-route-Date="@nextDate" class="btn btn-outline-light">Next &rarr;</a>
        </div>

        <form method="get" class="d-flex align-items-center gap-2">
            <label class="text-white mb-0">Date:</label>
            <input type="date" name="Date" value="@currentStr" class="form-control" onchange="this.form.submit()" />
        </form>
    </div>

    @if (Model.Appointments.Count == 0)
    {
        <div class="text-center py-5 text-muted border rounded border-secondary bg-surface">
            <h4>No appointments scheduled for @Model.SelectedDate.ToString("D")</h4>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-hover table-striped mb-0 text-white">
                <thead>
                    <tr>
                        <th class="border-secondary">Time</th>
                        <th class="border-secondary">Client</th>
                        <th class="border-secondary">Service</th>
                        <th class="border-secondary">Artist</th>
                        <th class="border-secondary">Status</th>
                        <th class="border-secondary text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var appt in Model.Appointments)
                    {
                        <tr class="align-middle">
                            <td class="border-secondary">
                                <span class="badge bg-secondary">@appt.StartTime.ToString("t")</span>
                                <small class="text-muted d-block">@appt.EndTime.ToString("t")</small>
                            </td>
                            <td class="border-secondary">
                                @(appt.Client?.FullName ?? "Walk-In / Unknown")
                            </td>
                            <td class="border-secondary">@appt.ServiceType</td>
                            <td class="border-secondary">@appt.ArtistName</td>
                            <td class="border-secondary">
                                <span class="badge bg-info text-dark">@appt.Status</span>
                            </td>
                            <td class="border-secondary text-end">
                                <a asp-page="/Appointments/Edit" asp-route-id="@appt.Id" class="btn btn-sm btn-outline-info">
                                    Edit
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
