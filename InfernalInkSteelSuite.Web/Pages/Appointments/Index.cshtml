@page
@model InfernalInkSteelSuite.Web.Pages.Appointments.IndexModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Appointments";
}

<h2>Appointments</h2>

<form method="get" class="mb-4">
    <div class="row g-3 align-items-center">
        <div class="col-auto">
            <label for="date" class="col-form-label">Date:</label>
        </div>
        <div class="col-auto">
            <input type="date" id="date" name="Date" class="form-control" value="@Model.Date?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary">Go</button>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-dark table-hover">
        <thead>
            <tr>
                <th>Time</th>
                <th>Client</th>
                <th>Service</th>
                <th>Artist</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var a in Model.Appointments)
        {
            <tr>
                <td>@a.StartTime.ToString("t")</td>
                <td>@(a.Client != null ? a.Client.FullName : "Unknown")</td>
                <td>@a.ServiceType</td>
                <td>@a.ArtistName</td>
            </tr>
        }
        </tbody>
    </table>
</div>
