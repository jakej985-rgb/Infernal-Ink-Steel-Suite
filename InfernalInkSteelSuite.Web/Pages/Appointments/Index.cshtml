@page
@model InfernalInkSteelSuite.Web.Pages.Appointments.IndexModel
@{
    ViewData["Title"] = "Appointments";
    var prevDate = Model.SelectedDate.AddDays(-1).ToString("yyyy-MM-dd");
    var nextDate = Model.SelectedDate.AddDays(1).ToString("yyyy-MM-dd");
    var today = DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd");
    var currentStr = Model.SelectedDate.ToString("yyyy-MM-dd");
}

<section class="appointments-page">
    <header class="page-header d-flex justify-content-between align-items-center mb-4">
        <h1>Appointments</h1>
        <div class="d-flex gap-2">
            <a asp-page="/Appointments/Edit" class="btn btn-primary d-flex align-items-center gap-2">
                <span>+ New Appointment</span>
            </a>
        </div>
    </header>

    <div class="appointments-container">
        <!-- Sidebar: Purgatory / Waitlist -->
        <aside class="purgatory-sidebar rounded">
            <h5 class="text-uppercase border-bottom border-secondary pb-2 mb-3">
                <i class="bi bi-hourglass-split me-2 text-warning"></i>Purgatory (Waitlist)
            </h5>

            @if (Model.WaitlistAppointments.Count == 0)
            {
                <div class="text-muted small fst-italic text-center py-4">
                    No souls waiting in limbo...
                </div>
            }
            else
            {
                <div class="purgatory-list d-flex flex-column gap-2" style="min-height: 200px;">
                    @foreach (var appt in Model.WaitlistAppointments)
                    {
                        <!-- Compact version of Appointment Card for Sidebar -->
                        <div class="soul-contract-card p-2 mb-0" data-id="@appt.Id" draggable="true" style="cursor: grab;">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <div class="fw-bold small">@appt.Client?.FullName</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@appt.ServiceType</div>
                                </div>
                                <div class="status-rune rune-pending" style="width: 24px; height: 24px; font-size: 0.8rem;">
                                    <i class="bi bi-hourglass-split"></i>
                                </div>
                            </div>
                            <div class="mt-2" style="font-size: 0.7rem;">
                                <i class="bi bi-clock"></i> @appt.StartTime.ToString("MMM dd")
                                <span class="ms-1 text-warning">(@((int)(appt.EndTime - appt.StartTime).TotalMinutes) m)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        </aside>

        <!-- Main Stage -->
        <main class="main-stage">
            <!-- Magma Calendar -->
            <partial name="_MagmaCalendar" model="Model" />

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="text-muted small">
                    Now viewing rituals for <span class="text-white fw-bold">@Model.SelectedDate.ToString("D")</span>
                </div>

                <!-- Search "Oracle" Trigger -->
                <button class="btn btn-outline-light btn-sm" title="Consult the Oracle (Search)">
                    <i class="bi bi-eye me-2"></i>Consult the Oracle
                </button>
            </div>

            @if (Model.Appointments.Count == 0)
            {
                <div class="text-center py-5 text-muted border rounded border-secondary bg-surface">
                    <h4>No rituals scheduled for @Model.SelectedDate.ToString("D")</h4>
                    <p class="mb-0">The studio is silent...</p>
                </div>
            }
            else
            {
                <div class="appointments-timeline gig-time-track">
                    @foreach (var appt in Model.Appointments)
                    {
                        <partial name="_AppointmentCard" model="appt" />
                    }
                </div>
            }
        </main>
    </div>
</section>

<!-- Floating "Summon" Button -->
<div class="position-fixed bottom-0 end-0 p-4" style="z-index: 1000">
    <a asp-page="/Appointments/Edit"
        class="btn btn-primary rounded-circle shadow-lg d-flex align-items-center justify-content-center"
        style="width: 60px; height: 60px; font-size: 24px;">
        <i class="bi bi-plus-lg"></i>
    </a>
</div>

@section Scripts {
    <script src="~/js/appointments.js"></script>
}

