@page
@model InfernalInkSteelSuite.Web.Pages.Appointments.IndexModel
@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Appointments";
}

<h2>Appointments</h2>

<div class="card bg-dark border-secondary mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-center">
            <div class="col-auto">
                <label for="date" class="col-form-label fw-bold">Select Date:</label>
            </div>
            <div class="col-auto">
                <input type="date" id="date" name="Date" class="form-control bg-dark text-white border-secondary"
                    value="@Model.Date?.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
            </div>
            <div class="col-auto">
                <small class="text-muted ms-2">Select a date to view schedule</small>
            </div>
        </form>
    </div>
</div>

<div class="card bg-dark border-secondary">
    <div class="table-responsive">
        <table class="table table-dark table-striped table-hover m-0 align-middle">
            <thead class="text-secondary text-uppercase small">
                <tr>
                    <th scope="col" class="ps-3">Time</th>
                    <th scope="col">Client</th>
                    <th scope="col">Service</th>
                    <th scope="col">Artist</th>
                    <th scope="col" class="text-end pe-3">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Appointments.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            No appointments scheduled for this date.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var a in Model.Appointments)
                    {
                        <tr>
                            <td class="ps-3 fw-bold text-accent">@a.StartTime.ToString("t")</td>
                            <td>
                                <div class="fw-bold text-white">@(a.Client?.FullName ?? "Unknown")</div>
                                @if (a.Client != null)
                                {
                                    <div class="small text-muted">@a.Client.Phone</div>
                                }
                            </td>
                            <td>@a.ServiceType</td>
                            <td>@a.ArtistName</td>
                            <td class="text-end pe-3">
                                <span class="badge bg-secondary">@a.Status</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
