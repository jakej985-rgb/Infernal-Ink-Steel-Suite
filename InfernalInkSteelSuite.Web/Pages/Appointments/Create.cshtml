@page
@model InfernalInkSteelSuite.Web.Pages.Appointments.CreateModel
@{
    ViewData["Title"] = "New Appointment";
}

<h2>New Appointment</h2>

<hr />
<div class="row">
    <div class="col-md-6">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.ClientId" class="control-label">Client</label>
                <select asp-for="Appointment.ClientId" class="form-control" asp-items="Model.ClientOptions">
                    <option value="">-- Select Client --</option>
                </select>
                <span asp-validation-for="Appointment.ClientId" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.DateTime" class="control-label"></label>
                <input asp-for="Appointment.DateTime" class="form-control" type="datetime-local" />
                <span asp-validation-for="Appointment.DateTime" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.DurationMinutes" class="control-label">Duration (Minutes)</label>
                <input asp-for="Appointment.DurationMinutes" class="form-control" />
                <span asp-validation-for="Appointment.DurationMinutes" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.ServiceType" class="control-label">Service Type</label>
                <input asp-for="Appointment.ServiceType" class="form-control" placeholder="e.g. Tattoo, Piercing" />
                <span asp-validation-for="Appointment.ServiceType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.ServiceCategory" class="control-label">Category</label>
                <input asp-for="Appointment.ServiceCategory" class="form-control" placeholder="e.g. Blackwork, Lobe" />
                <span asp-validation-for="Appointment.ServiceCategory" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.PriceType" class="control-label">Price Type</label>
                <select asp-for="Appointment.PriceType" class="form-control">
                    <option value="Fixed">Fixed</option>
                    <option value="Hourly">Hourly</option>
                </select>
                <span asp-validation-for="Appointment.PriceType" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.PriceCharged" class="control-label">Price</label>
                <input asp-for="Appointment.PriceCharged" class="form-control" />
                <span asp-validation-for="Appointment.PriceCharged" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.Status" class="control-label"></label>
                <select asp-for="Appointment.Status" class="form-control">
                    <option value="Scheduled">Scheduled</option>
                    <option value="Confirmed">Confirmed</option>
                    <option value="Completed">Completed</option>
                    <option value="Canceled">Canceled</option>
                    <option value="NoShow">No Show</option>
                </select>
                <span asp-validation-for="Appointment.Status" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Appointment.Notes" class="control-label"></label>
                <textarea asp-for="Appointment.Notes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Appointment.Notes" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
                <a asp-page="Index" class="btn btn-secondary">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
