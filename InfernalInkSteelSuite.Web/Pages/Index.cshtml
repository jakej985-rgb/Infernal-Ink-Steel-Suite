@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <div class="hero-overlay"></div>
    <div class="hero-content">
        <h1 class="hero-title">Infernal Ink & Steel</h1>
        <p class="hero-subtitle">Where Art Meets Agony. Premium Tattoos & Piercings.</p>
        <div class="hero-btn-group">
            <a href="#" class="btn btn-primary btn-lg">Book Appointment</a>
            <a href="#" class="btn btn-outline-light btn-lg">View Artists</a>
        </div>
    </div>
</div>

<div class="container features-section">
    <div class="row g-4">
        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">🎨</div>
                <h3>World Class Artists</h3>
                <p class="text-muted">Our team of award-winning artists specialize in realism, traditional, and custom
                    designs.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">💎</div>
                <h3>Premium Piercing</h3>
                <p class="text-muted">High-end jewelry and professional piercing services in a sterile environment.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="feature-card text-center">
                <div class="feature-icon">🛡️</div>
                <h3>Sterile & Safe</h3>
                <p class="text-muted">We adhere to the strictest hygiene standards to ensure your safety and comfort.
                </p>
            </div>
        </div>
    </div>
</div>
