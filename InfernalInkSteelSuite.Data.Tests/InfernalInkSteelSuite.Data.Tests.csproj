<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Ensure all referenced assemblies (like Microsoft.Data.Sqlite) are copied to bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- xUnit test framework -->
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Code coverage (optional, harmless in CI) -->
    <PackageReference Include="coverlet.collector" Version="6.0.0" />

    <!-- Explicit SQLite dependency so the testhost can load it -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <!-- (Optional but safe) meta package; helps pull everything together -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
  </ItemGroup>

  <!-- Projects under test -->
  <ItemGroup>
    <ProjectReference Include="..\InfernalInkSteelSuite.Domain\InfernalInkSteelSuite.Domain.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Data\InfernalInkSteelSuite.Data.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Repositories\InfernalInkSteelSuite.Repositories.csproj" />
  </ItemGroup>

  <!-- Exclude WPF + NUnit + MSTest tests from this CI project -->
  <ItemGroup>
    <!-- Uses NUnit + ViewModels from WPF -->
    <Compile Remove="StatsViewModelTests.cs" />
    <!-- Uses MSTest attributes -->
    <Compile Remove="ClientTests.cs" />
  </ItemGroup>

</Project>
