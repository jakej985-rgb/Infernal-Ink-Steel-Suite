<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Test frameworks -->
  <ItemGroup>
    <!-- xUnit for repository/domain tests -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- MSTest for ClientTests (if you want to keep them) -->
    <PackageReference Include="MSTest.TestFramework" Version="3.5.4" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.4" />

    <!-- Coverage collector (optional but nice) -->
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
  </ItemGroup>

  <!-- Pure library dependencies -->
  <ItemGroup>
    <ProjectReference Include="..\InfernalInkSteelSuite.Domain\InfernalInkSteelSuite.Domain.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Data\InfernalInkSteelSuite.Data.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Repositories\InfernalInkSteelSuite.Repositories.csproj" />
  </ItemGroup>

  <!-- Exclude WPF/NUnit-based tests from this project -->
  <ItemGroup>
    <Compile Remove="StatsViewModelTests.cs" />
  </ItemGroup>

</Project>
