<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <!-- Ensure all referenced assemblies (Sqlite, Newtonsoft, etc.) are copied into bin -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Test framework + tooling -->
  <ItemGroup>
    <!-- xUnit only -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Coverage (optional, safe in CI) -->
    <PackageReference Include="coverlet.collector" Version="6.0.0" />

    <!-- Explicit DB + JSON dependencies so testhost can load them -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <!-- Projects under test -->
  <ItemGroup>
    <ProjectReference Include="..\InfernalInkSteelSuite.Domain\InfernalInkSteelSuite.Domain.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Data\InfernalInkSteelSuite.Data.csproj" />
    <ProjectReference Include="..\InfernalInkSteelSuite.Repositories\InfernalInkSteelSuite.Repositories.csproj" />
  </ItemGroup>

  <!-- Exclude WPF + NUnit + MSTest tests from this CI project -->
  <ItemGroup>
    <!-- Uses NUnit + WPF ViewModels -->
    <Compile Remove="StatsViewModelTests.cs" />
    <!-- Uses MSTest -->
    <Compile Remove="ClientTests.cs" />
  </ItemGroup>

</Project>
