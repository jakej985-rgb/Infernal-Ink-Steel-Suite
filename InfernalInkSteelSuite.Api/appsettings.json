{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=../InfernalInkSteelSuite.Data/infernalinksteel.db"
  },
  "FileStorage": {
    "RootPath": "../InfernalInkSteelSuite.Data/Uploads"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Jwt": {
    "Key": "A-STRONGER-DEFAULT-KEY-FOR-LOCAL-DEV-ENV-ONLY-CHANGE-THIS-IN-PRODUCTION-VIA-ENV-VAR-OR-SECRET-STORE",
    "Issuer": "InfernalInkSteelSuite.Api",
    "Audience": "InfernalInkSteelSuite.Clients",
    "ExpiryHours": 1
  }
}