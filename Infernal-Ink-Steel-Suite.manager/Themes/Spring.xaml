<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subtle Spring Palette -->
    <Color x:Key="AppBackgroundColor">#FFf0f9f3</Color>   <!-- Very Light Green -->
    <Color x:Key="SurfaceColor">#FFe3f3e7</Color>       <!-- Pale Green -->
    <Color x:Key="SurfaceAltColor">#FFd1e9d9</Color>      <!-- Light Green -->

    <Color x:Key="PrimaryColor">#FFa3de83</Color>        <!-- Soft Green -->
    <Color x:Key="PrimaryHoverColor">#FFb9e69f</Color>   <!-- Lighter Green -->
    <Color x:Key="PrimaryPressedColor">#FF8cc869</Color>  <!-- Darker Green -->

    <Color x:Key="AccentColor">#FFf7dc6f</Color>         <!-- Pale Gold -->
    <Color x:Key="DangerColor">#FFe74c3c</Color>

    <Color x:Key="PrimaryTextColor">#FF3e2723</Color>     <!-- Dark Brown -->
    <Color x:Key="SecondaryTextColor">#FF6d4c41</Color>   <!-- Brown -->
    <Color x:Key="MutedTextColor">#FF8d6e63</Color>      <!-- Light Brown -->
    <Color x:Key="AccentTextColor">#FF3e2723</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A000000"/>

    <!-- Holiday Asset -->
    <ImageBrush x:Key="HolidayImageBrush" ImageSource="/Assets/Images/spring.png" Stretch="Uniform" />

    <!-- Window background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource AppBackgroundColor}" />

</ResourceDictionary>
