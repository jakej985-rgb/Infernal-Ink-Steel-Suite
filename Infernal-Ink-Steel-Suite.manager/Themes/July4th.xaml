<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subtle 4th of July Palette -->
    <Color x:Key="AppBackgroundColor">#FF2c3e50</Color>   <!-- Midnight Blue -->
    <Color x:Key="SurfaceColor">#FF34495e</Color>       <!-- Wet Asphalt -->
    <Color x:Key="SurfaceAltColor">#FF4a6fa5</Color>      <!-- Steel Blue -->

    <Color x:Key="PrimaryColor">#FFc0392b</Color>        <!-- Pomegranate (Deep Red) -->
    <Color x:Key="PrimaryHoverColor">#FFe74c3c</Color>   <!-- Lighter Red -->
    <Color x:Key="PrimaryPressedColor">#FFa93226</Color>  <!-- Darker Red -->

    <Color x:Key="AccentColor">#FFecf0f1</Color>         <!-- Clouds (Off-white) -->
    <Color x:Key="DangerColor">#FFc0392b</Color>

    <Color x:Key="PrimaryTextColor">#FFecf0f1</Color>     <!-- Clouds (Off-white) -->
    <Color x:Key="SecondaryTextColor">#FFbdc3c7</Color>   <!-- Silver -->
    <Color x:Key="MutedTextColor">#FF95a5a6</Color>      <!-- Gray -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <!-- Holiday Asset -->
    <ImageBrush x:Key="HolidayImageBrush" ImageSource="/Assets/Images/july4th.png" Stretch="Uniform" />

    <!-- Window background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource AppBackgroundColor}" />

</ResourceDictionary>
