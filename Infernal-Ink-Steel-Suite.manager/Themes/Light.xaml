<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base colors -->
    <Color x:Key="AppBackgroundColor">#FFFFFFFF</Color>   <!-- white -->
    <Color x:Key="SurfaceColor">#FFF0F0F0</Color>
    <Color x:Key="SurfaceAltColor">#FFE0E0E0</Color>

    <Color x:Key="PrimaryColor">#FF007ACC</Color>        <!-- blue -->
    <Color x:Key="PrimaryHoverColor">#FF0099FF</Color>
    <Color x:Key="PrimaryPressedColor">#FF005A9E</Color>

    <Color x:Key="AccentColor">#FFD63384</Color>         <!-- pink -->
    <Color x:Key="DangerColor">#FFDC3545</Color>

    <Color x:Key="PrimaryTextColor">#FF000000</Color>
    <Color x:Key="SecondaryTextColor">#FF404040</Color>
    <Color x:Key="MutedTextColor">#FF808080</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1A000000"/>

    <!-- Window background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource AppBackgroundColor}" />

    <!-- Example textblock default -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFont}" />
    </Style>

    <!-- Grid / List background defaults -->
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="RowBackground" Value="{StaticResource SurfaceAltBrush}" />
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}" />
        <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
    </Style>
</ResourceDictionary>
