<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Subtle Thanksgiving Palette -->
    <Color x:Key="AppBackgroundColor">#FF4a2c2a</Color>   <!-- Dark Brown -->
    <Color x:Key="SurfaceColor">#FF6b4226</Color>       <!-- Russet -->
    <Color x:Key="SurfaceAltColor">#FF8a5a3a</Color>      <!-- Sienna -->

    <Color x:Key="PrimaryColor">#FFd35400</Color>        <!-- Pumpkin (Deep Orange) -->
    <Color x:Key="PrimaryHoverColor">#FFe67e22</Color>   <!-- Lighter Orange -->
    <Color x:Key="PrimaryPressedColor">#FFa04000</Color>  <!-- Darker Orange -->

    <Color x:Key="AccentColor">#FFf1c40f</Color>         <!-- Sunflower (Gold) -->
    <Color x:Key="DangerColor">#FFc0392b</Color>

    <Color x:Key="PrimaryTextColor">#FFecf0f1</Color>     <!-- Clouds (Off-white) -->
    <Color x:Key="SecondaryTextColor">#FFbdc3c7</Color>   <!-- Silver -->
    <Color x:Key="MutedTextColor">#FF95a5a6</Color>      <!-- Gray -->

    <!-- Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource SurfaceAltColor}" />

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1AFFFFFF"/>

    <!-- Holiday Asset -->
    <ImageBrush x:Key="HolidayImageBrush" ImageSource="/Assets/Images/thanksgiving.png" Stretch="Uniform" />

    <!-- Window background -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}"
                     Color="{StaticResource AppBackgroundColor}" />

</ResourceDictionary>
