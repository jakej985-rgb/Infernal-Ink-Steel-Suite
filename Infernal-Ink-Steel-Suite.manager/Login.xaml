<Window x:Class="InfernalInkSteelSuite.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Infernal Ink &amp; Steel Suite - Login"
        Height="350" Width="400"
        WindowStartupLocation="CenterScreen"
        Background="#121212">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Infernal Ink &amp; Steel Suite"
                   FontSize="22"
                   FontWeight="Bold"
                   Foreground="#FF00FFFF"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20" />

        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="Username" Foreground="White" Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameTextBox"
                     Height="28"
                     Margin="0,0,0,10" />

            <TextBlock Text="Password" Foreground="White" Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBox"
                         Height="28"
                         Margin="0,0,0,20" />

            <Button Content="Login"
                    Height="34"
                    Click="LoginButton_Click"
                    Background="#FF00FFFF"
                    Foreground="Black"
                    FontWeight="Bold"
                    Padding="10,0"
                    HorizontalAlignment="Center"
                    Width="120" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Foreground="OrangeRed"
                   HorizontalAlignment="Center"
                   Margin="0,10,0,0"/>
    </Grid>
</Window>
