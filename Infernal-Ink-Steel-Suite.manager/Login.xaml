<Window x:Class="InfernalInkSteelSuite.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InfernalInkSteelSuite.Controls"
        Title="Login" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420"/>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Branding Panel -->
            <StackPanel x:Name="BrandingPanel" Margin="8,0,8,12">
                <TextBlock x:Name="HeadlineLabel" Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaglineLabel" Text="Sign in to manage your day." FontSize="16" Foreground="#CCFFFFFF" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- User Grid -->
            <ScrollViewer x:Name="UserScrollArea" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0">
                <WrapPanel x:Name="UserGrid" Margin="8" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <!-- Login View -->
            <Grid x:Name="UserLoginView" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <controls:GlowAvatar x:Name="AvatarLabel" Size="140" Initials="U" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SelectedUserLabel" Text="Select User" FontSize="20" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Padding="14,6"
                               >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Select User">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <PasswordBox x:Name="PasswordEdit" Width="300" HorizontalAlignment="Center" Margin="0,18,0,0"
                                 Style="{StaticResource PasswordBoxStyle}"/>
                    <CheckBox x:Name="ShowPasswordCheck" Content="Show Password" HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="White"
                              Checked="ShowPasswordCheck_Checked" Unchecked="ShowPasswordCheck_Unchecked"/>
                    <TextBox x:Name="PasswordTextBox" Width="300" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed"
                             Style="{StaticResource TextBoxStyle}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <controls:NeonButton x:Name="BackButton" Content="Back" Width="140" Height="44" Margin="0,0,10,0" Click="Back_Click"/>
                        <controls:NeonButton x:Name="SignInButton" Content="Sign In" Width="140" Height="44" Click="SignIn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
