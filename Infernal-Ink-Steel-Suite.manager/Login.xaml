<Window x:Class="InfernalInkSteelSuite.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:InfernalInkSteelSuite.Controls"
        Title="Login" Height="620" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Right" VerticalAlignment="Top" Width="420"/>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Branding Panel -->
            <StackPanel x:Name="BrandingPanel" Margin="8,0,8,12">
                <TextBlock x:Name="HeadlineLabel" Text="Welcome Back" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"/>
                <TextBlock x:Name="TaglineLabel" Text="Sign in to manage your day." FontSize="16" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- User Grid -->
            <ScrollViewer x:Name="UserScrollArea" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                <UniformGrid x:Name="UserGrid" HorizontalAlignment="Stretch" VerticalAlignment="Center" Columns="3"/>
            </ScrollViewer>

            <!-- Login View -->
            <Grid x:Name="UserLoginView" Grid.Row="1" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <!-- Replace GlowAvatar with a simple Ellipse and TextBlock for initials -->
                    <Grid HorizontalAlignment="Center" Width="140" Height="140">
                        <Ellipse Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource PrimaryBorderBrush}" StrokeThickness="4"/>
                        <TextBlock x:Name="AvatarInitials" Text="U" FontSize="64" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="SelectedUserLabel" Text="Select User" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Padding="14,6"
                               >
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Background" Value="Transparent"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="Select User">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <controls:PasswordBoxWithToggle x:Name="PasswordEdit" 
                                                    Width="300" 
                                                    HorizontalAlignment="Center" 
                                                    Margin="0,18,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <Button x:Name="BackButton" Content="Back" Width="140" Height="44" Margin="0,0,10,0" Click="Back_Click"/>
                        <Button x:Name="SignInButton" Content="Sign In" Width="140" Height="44" Click="SignIn_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
