<Window x:Class="InfernalInkSteelSuite.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:BoolToBrushConverter x:Key="BoolToBrushConverter" xmlns:converters="clr-namespace:InfernalInkSteelSuite.Converters"/>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}" Panel.ZIndex="1">
            <Grid.Effect>
                <DropShadowEffect ShadowDepth="0" BlurRadius="15" Opacity="0.5" Color="Black"/>
            </Grid.Effect>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Content="Home" Click="Home_Click"/>
                <Button Content="Clients" Click="Clients_Click"/>
                <Button Content="Appointments" Click="Appointments_Click"/>
                <Button Content="Create Quote" Click="CreateQuote_Click"/>
                <Button Content="Quote History" Click="Quotes_Click"/>
                <Button Content="Documents" Click="Documents_Click"/>
                <Button Content="Statistics" Click="Statistics_Click"/>
                <Button Content="Settings" Click="Settings_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                <Image x:Name="SidebarArtwork" Stretch="Uniform" Height="150"/>
                <TextBlock Text="Tattoo Rate:" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="TattooRateLabel" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Shop Minimum:" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="ShopMinimumRateLabel" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Piercing Rate:" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="PiercingRateLabel" Foreground="{DynamicResource TextColor}"/>
                <Button Content="Logout" Click="Logout_Click" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Column="1" x:Name="MainContent" Margin="0,0,0,30"/>
        
        <!-- Status Bar -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Bottom" Height="30" Background="{DynamicResource SurfaceAltBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="0,1,0,0" Padding="10,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding DataModeDisplay}" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Ellipse Width="8" Height="8" Fill="{Binding IsOnline, Converter={StaticResource BoolToBrushConverter}}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontStyle="Italic"/>
                
                <ProgressBar Grid.Column="2" Width="100" Height="10" IsIndeterminate="True" Visibility="{Binding IsSyncing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </Grid> 
        </Border>
    </Grid>
</Window>
