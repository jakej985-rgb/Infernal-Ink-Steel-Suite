<Window x:Class="InfernalInkSteelSuite.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard" Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <Button Content="Home" Click="Home_Click"/>
                <Button Content="Clients" Click="Clients_Click"/>
                <Button Content="Appointments" Click="Appointments_Click"/>
                <Button Content="Create Quote" Click="CreateQuote_Click"/>
                <Button Content="Quote History" Click="Quotes_Click"/>
                <Button Content="Documents" Click="Documents_Click"/>
                <Button Content="Statistics" Click="Statistics_Click"/>
                <Button Content="Settings" Click="Settings_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                <Image x:Name="SidebarArtwork" Stretch="Uniform" Height="150"/>
                <TextBlock Text="Tattoo Rate:" FontWeight="Bold" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="TattooRateLabel" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Shop Minimum:" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="ShopMinimumRateLabel" Foreground="{DynamicResource TextColor}"/>
                <TextBlock Text="Piercing Rate:" FontWeight="Bold" Margin="0,10,0,0" Foreground="{DynamicResource TextColor}"/>
                <TextBlock x:Name="PiercingRateLabel" Foreground="{DynamicResource TextColor}"/>
                <Button Content="Logout" Click="Logout_Click" Margin="0,20,0,0"/>
            </StackPanel>
        </Grid>

        <ContentControl Grid.Column="1" x:Name="MainContent"/>
    </Grid>
</Window>
