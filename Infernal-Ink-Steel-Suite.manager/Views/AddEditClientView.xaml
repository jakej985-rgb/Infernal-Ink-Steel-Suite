<Window x:Class="InfernalInkSteelSuite.Views.AddEditClientView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add/Edit Client" Height="450" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Content="First Name:" Grid.Row="0" Grid.Column="0"/>
        <TextBox Text="{Binding Client.FirstName}" Grid.Row="0" Grid.Column="1"/>

        <Label Content="Last Name:" Grid.Row="1" Grid.Column="0"/>
        <TextBox Text="{Binding Client.LastName}" Grid.Row="1" Grid.Column="1"/>

        <Label Content="Phone:" Grid.Row="2" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Phone}" Grid.Row="2" Grid.Column="1"/>

        <Label Content="Email:" Grid.Row="3" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Email}" Grid.Row="3" Grid.Column="1"/>

        <Label Content="Visits:" Grid.Row="4" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Visits}" Grid.Row="4" Grid.Column="1"/>

        <Label Content="Notes:" Grid.Row="5" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Notes}" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
