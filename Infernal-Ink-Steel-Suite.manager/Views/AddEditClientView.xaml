<Window x:Class="InfernalInkSteelSuite.Views.AddEditClientView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:InfernalInkSteelSuite.Converters"
        Title="Add/Edit Client" Height="480" Width="560">
    <Window.Resources>
        <converters:PhotoToImageSourceConverter x:Key="PhotoToImageSourceConverter"/>
        <converters:PhotoPathToVisibilityConverter x:Key="PhotoPathToVisibilityConverter"/>
        <Style x:Key="OptionalTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlCornerRadius}"
                                SnapsToDevicePixels="true">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                <TextBlock x:Name="Watermark" Text="(optional)" Foreground="Gray" 
                                           IsHitTestVisible="False" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" FontStyle="Italic"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Watermark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Name Section with Avatar -->
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Name Fields (Left Side) -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Label Content="First Name:" Grid.Row="0" Grid.Column="0"/>
                <TextBox x:Name="FirstNameTextBox" Text="{Binding Client.FirstName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="0" Grid.Column="1"/>

                <Label Content="Middle Name:" Grid.Row="1" Grid.Column="0"/>
                <TextBox Text="{Binding Client.MiddleName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="1" Grid.Column="1" Style="{StaticResource OptionalTextBoxStyle}"/>

                <Label Content="Last Name:" Grid.Row="2" Grid.Column="0"/>
                <TextBox Text="{Binding Client.LastName, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1"/>
            </Grid>

            <!-- Avatar Circle (Right Side) -->
            <Grid Grid.Column="1" Width="120" Height="120" Margin="20,0,0,0" VerticalAlignment="Center">
                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Change Photo..." Command="{Binding SelectPhotoCommand}"/>
                        <MenuItem Header="Clear Photo" Command="{Binding ClearPhotoCommand}"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <!-- Outer Glow Ring -->
                <Ellipse Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" Margin="2">
                    <Ellipse.Effect>
                        <DropShadowEffect Color="{Binding Source={StaticResource AccentBrush}, Path=Color}" 
                                         BlurRadius="15" 
                                         ShadowDepth="0" 
                                         Opacity="0.8"/>
                    </Ellipse.Effect>
                </Ellipse>

                <!-- Photo or Placeholder -->
                <Grid>
                    <!-- Photo Image (if exists) -->
                    <Ellipse Margin="5" Visibility="{Binding Client.PhotoPath, Converter={StaticResource PhotoPathToVisibilityConverter}, ConverterParameter=HasPhoto}">
                        <Ellipse.Fill>
                            <ImageBrush Stretch="UniformToFill" ImageSource="{Binding Client.PhotoPath, Converter={StaticResource PhotoToImageSourceConverter}}"/>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Placeholder Background (if no photo) -->
                    <Ellipse Fill="{DynamicResource SurfaceBrush}" Margin="5" Visibility="{Binding Client.PhotoPath, Converter={StaticResource PhotoPathToVisibilityConverter}, ConverterParameter=NoPhoto}"/>

                    <!-- Initials (if no photo) -->
                    <TextBlock Text="{Binding AvatarInitials}" 
                              FontSize="36" 
                              FontWeight="Bold" 
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              HorizontalAlignment="Center" 
                              VerticalAlignment="Center"
                              Visibility="{Binding Client.PhotoPath, Converter={StaticResource PhotoPathToVisibilityConverter}, ConverterParameter=NoPhoto}"/>
                </Grid>

                <!-- Click target overlay -->
                <Ellipse Fill="Transparent" MouseDown="Avatar_MouseDown" Cursor="Hand" ToolTip="Click to change photo, right-click for options"/>
            </Grid>
        </Grid>

        <Label Content="Phone:" Grid.Row="1" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Phone}" Grid.Row="1" Grid.Column="1"/>

        <Label Content="Email:" Grid.Row="2" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Email}" Grid.Row="2" Grid.Column="1"/>

        <Label Content="Visits:" Grid.Row="3" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Visits}" Grid.Row="3" Grid.Column="1"/>

        <Label Content="Notes:" Grid.Row="4" Grid.Column="0"/>
        <TextBox Text="{Binding Client.Notes}" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" AcceptsReturn="True"/>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" TextWrapping="Wrap" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Margin="5"/>

        <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.Column="1" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="5"/>
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
