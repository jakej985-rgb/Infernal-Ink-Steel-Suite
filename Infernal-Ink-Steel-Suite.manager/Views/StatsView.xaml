<UserControl x:Class="InfernalInkSteelSuite.Views.StatsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views"
             xmlns:scottplot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <ScrollViewer>
            <StackPanel Margin="10">
                <ComboBox x:Name="YearSelector" Width="200" HorizontalAlignment="Left" ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" SelectionChanged="YearSelector_SelectionChanged"/>
                <TextBlock x:Name="IncomeLabel" Text="{Binding TotalIncome, StringFormat='Total Income: ${0:F2}'}" Margin="0,10,0,0"/>
                <TextBlock x:Name="VisitsLabel" Text="{Binding TotalVisits, StringFormat='Total Visits: {0}'}" Margin="0,5,0,0"/>
                <TextBlock x:Name="HoursLabel" Text="{Binding TotalHours, StringFormat='Total Tattoo Hours: {0:F1}'}" Margin="0,5,0,0"/>
                <scottplot:WpfPlot x:Name="IncomeChart" Height="300" Margin="0,10,0,0"/>
                <scottplot:WpfPlot x:Name="VisitsChart" Height="300" Margin="0,10,0,0"/>
                <scottplot:WpfPlot x:Name="HoursChart" Height="300" Margin="0,10,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
