<Window x:Class="InfernalInkSteelSuite.Views.EditAppointmentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Appointment" Height="450" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Client:"/>
        <ComboBox Grid.Row="0" Grid.Column="1" x:Name="ClientComboBox" SelectedValue="{Binding Appointment.ClientId}" DisplayMemberPath="FirstName" SelectedValuePath="Id"/>

        <Label Grid.Row="1" Grid.Column="0" Content="Date:"/>
        <DatePicker Grid.Row="1" Grid.Column="1" x:Name="DatePicker" SelectedDate="{Binding Appointment.DateTime}"/>

        <Label Grid.Row="2" Grid.Column="0" Content="Time:"/>
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="TimeTextBox" Text="{Binding Time}"/>

        <Label Grid.Row="3" Grid.Column="0" Content="Duration (mins):"/>
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="DurationTextBox" Text="{Binding Appointment.DurationMinutes}"/>

        <Label Grid.Row="4" Grid.Column="0" Content="Service Type:"/>
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="ServiceTypeTextBox" Text="{Binding Appointment.ServiceType}"/>

        <Label Grid.Row="5" Grid.Column="0" Content="Service Category:"/>
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="ServiceCategoryTextBox" Text="{Binding Appointment.ServiceCategory}"/>

        <Label Grid.Row="6" Grid.Column="0" Content="Price Type:"/>
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="PriceTypeTextBox" Text="{Binding Appointment.PriceType}"/>

        <Label Grid.Row="7" Grid.Column="0" Content="Price Charged:"/>
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="PriceChargedTextBox" Text="{Binding Appointment.PriceCharged}"/>

        <Label Grid.Row="8" Grid.Column="0" Content="Notes:"/>
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="NotesTextBox" Text="{Binding Appointment.Notes}" TextWrapping="Wrap" AcceptsReturn="True"/>

        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" x:Name="SaveButton" Click="SaveButton_Click" Margin="5"/>
            <Button Content="Cancel" IsCancel="True" Margin="5"/>
        </stackpanel>
    </Grid>
</Window>
