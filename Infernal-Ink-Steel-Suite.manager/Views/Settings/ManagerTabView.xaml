<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.ManagerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Header -->
            <TextBlock Text="User Management" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextColor}" Margin="0,0,0,20"/>

            <!-- User Selection -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Select User" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <DataGrid ItemsSource="{Binding Users}" 
                              SelectedItem="{Binding SelectedUser}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              MaxHeight="200"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

            <!-- User Information -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="ℹ️" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="User Information" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column -->
                    <StackPanel Grid.Column="0">
                        <Label Content="Department" Foreground="{DynamicResource TextColor}" FontWeight="Medium"/>
                        <ComboBox ItemsSource="{Binding Departments}" 
                                  SelectedItem="{Binding SelectedDepartment}"
                                  IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                                  Margin="0,0,0,10"/>
                    </StackPanel>

                    <!-- Right Column -->
                    <StackPanel Grid.Column="2">
                        <Label Content="Commission Rate (%)" Foreground="{DynamicResource TextColor}" FontWeight="Medium"/>
                        <TextBox Text="{Binding CommissionRate, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                                 Margin="0,0,0,10"/>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Permissions -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔐" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Permissions" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextColor}"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <CheckBox Content="Can View Reports" 
                              IsChecked="{Binding CanViewReports}"
                              IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                              Foreground="{DynamicResource TextColor}"
                              Margin="0,5"/>
                    <CheckBox Content="Can Manage Schedule" 
                              IsChecked="{Binding CanManageSchedule}"
                              IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                              Foreground="{DynamicResource TextColor}"
                              Margin="0,5"/>
                    <CheckBox Content="Can View Financials" 
                              IsChecked="{Binding CanViewFinancials}"
                              IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                              Foreground="{DynamicResource TextColor}"
                              Margin="0,5"/>
                    <CheckBox Content="Can Manage Inventory" 
                              IsChecked="{Binding CanManageInventory}"
                              IsEnabled="{Binding SelectedUser, Converter={StaticResource NullToBooleanConverter}}"
                              Foreground="{DynamicResource TextColor}"
                              Margin="0,5"/>
                </StackPanel>
            </Expander>

            <!-- Actions -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Reset to Role Defaults" 
                        Command="{Binding ResetPermissionsCommand}"
                        Style="{StaticResource OutlinedButtonStyle}"
                        Margin="0,0,10,0"/>
                <Button Content="Save Settings" 
                        Command="{Binding SaveUserSettingsCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
