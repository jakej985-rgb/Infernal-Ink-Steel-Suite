<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.ManagerTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="Select User" Foreground="{DynamicResource TextColor}"/>
            <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Username" Background="#333333" Foreground="{DynamicResource TextColor}"/>
            <Label Content="Select Role" Foreground="{DynamicResource TextColor}"/>
            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Background="#333333" Foreground="{DynamicResource TextColor}"/>
            <Button Content="Update Role" Command="{Binding UpdateRoleCommand}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
