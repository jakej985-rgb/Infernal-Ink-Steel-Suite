<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.UserTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             xmlns:attachedProperties="clr-namespace:InfernalInkSteelSuite.AttachedProperties"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="20">
            <GroupBox Header="Profile">

            </GroupBox>

            <GroupBox Header="Appearance &amp; theme" Margin="0,10,0,0">
                <StackPanel>
                    <Label Content="Select Theme" Foreground="{DynamicResource TextColor}"/>
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding SelectedTheme}" DisplayMemberPath="DisplayName"/>
                    <CheckBox Content="Enable Automatic Holiday Themes" IsChecked="{Binding EnableAutomaticHolidayThemes}" Margin="0,10,0,0"/>

                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,20,0,0">
                        <StackPanel>
                            <Label Content="Theme Preview" FontWeight="Bold" Foreground="{DynamicResource TextColor}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <Label Content="This is a label" Foreground="{DynamicResource TextColor}" />
                            <Button Content="This is a button" Margin="0,5,0,0" />
                            <CheckBox Content="This is a checkbox" IsChecked="True" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Security" Margin="0,10,0,0">
                <Button Content="Change password..." Command="{Binding OpenChangePasswordDialogCommand}"/>
            </GroupBox>
        </StackPanel>
    </Grid>
</UserControl>
