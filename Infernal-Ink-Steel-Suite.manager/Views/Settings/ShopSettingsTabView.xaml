<UserControl x:Class="Infernal_Ink_Steel_Suite.manager.Views.Settings.ShopSettingsTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Infernal_Ink_Steel_Suite.manager.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel Margin="20">
            <Label Content="Shop Name" Foreground="White"/>
            <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
            <Label Content="Tattoo Rate (per hour)" Foreground="White"/>
            <TextBox Text="{Binding TattooRate, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
            <Label Content="Piercing Rate (single)" Foreground="White"/>
            <TextBox Text="{Binding PiercingSingle, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
            <Label Content="Piercing Rate (multiple)" Foreground="White"/>
            <TextBox Text="{Binding PiercingMulti, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,20,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
