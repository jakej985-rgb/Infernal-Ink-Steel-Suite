<UserControl x:Class="Infernal_Ink_Steel_Suite.manager.Views.Settings.AdminTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Infernal_Ink_Steel_Suite.manager.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <TabItem Header="User Management">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="Add User" Command="{Binding AddUserCommand}" Margin="5"/>
                        <Button Content="Update Role" Command="{Binding UpdateRoleCommand}" Margin="5"/>
                        <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}" Margin="5"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Login Screen Branding">
                <StackPanel Margin="20">
                    <Label Content="Headline" Foreground="White"/>
                    <TextBox Text="{Binding LoginHeadline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                    <Label Content="Tagline" Foreground="White"/>
                    <TextBox Text="{Binding LoginTagline, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                    <Label Content="Background Image Path" Foreground="White"/>
                    <TextBox Text="{Binding LoginBackgroundPath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}"/>
                    <Button Content="Save Branding" Command="{Binding SaveBrandingCommand}" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
