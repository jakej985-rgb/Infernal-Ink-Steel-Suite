<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.AdminTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <TabControl>
            <TabItem Header="User Management">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="Add User" Command="{Binding AddUserCommand}" Margin="5"/>
                        <Button Content="Update Role" Command="{Binding UpdateRoleCommand}" Margin="5"/>
                        <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}" Margin="5"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Role" Binding="{Binding Role}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Login Screen Branding">
                <StackPanel Margin="20">
                    <Label Content="Headline" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding LoginHeadline, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                    <Label Content="Tagline" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding LoginTagline, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                    <Label Content="Background Image Path" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding LoginBackgroundPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
            <TabItem Header="Shop Settings">
                <StackPanel Margin="20">
                    <Label Content="Tattoo Rate Per Hour" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding TattooRate, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                    <Label Content="Piercing Rate" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding PiercingSingle, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}"/>
                    <Label Content="Sidebar Artwork" Foreground="{DynamicResource TextColor}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SidebarArtworkPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource TextBoxStyle}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseCommand}" Margin="10,0,0,0"/>
                    </Grid>
                    <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="0,20,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
