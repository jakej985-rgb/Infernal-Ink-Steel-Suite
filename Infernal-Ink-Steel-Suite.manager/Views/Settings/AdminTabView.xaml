<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.AdminTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="800" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="OutlinedButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="SettingLabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="Padding" Value="0,5"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <!-- Unsaved Changes Banner -->
            <Border Background="#33FFA500" BorderBrush="Orange" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20" Padding="15"
                    Visibility="{Binding HasUnsavedChanges, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚠️" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="You have unsaved changes" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="{Binding LastSavedTimestamp, StringFormat='Last saved: {0:g}'}" Opacity="0.7" FontStyle="Italic" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Restore Defaults" Command="{Binding RestoreDefaultsCommand}" Margin="0,0,10,0" Style="{StaticResource OutlinedButtonStyle}"/>
                        <Button Content="Save Changes" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Search Box -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="10" FontSize="14"
                         Tag="Search settings..." />
            </Grid>

            <!-- User Management -->
            <Expander IsExpanded="True" Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="User Management" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Toolbar -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <Button Content="Add User" Command="{Binding AddUserCommand}" Margin="0,0,5,0" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="Update Role" Command="{Binding UpdateRoleCommand}" Margin="0,0,5,0" Style="{StaticResource OutlinedButtonStyle}"/>
                            <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}" Margin="0,0,5,0" Style="{StaticResource OutlinedButtonStyle}"/>
                            <Button Content="Delete User" Command="{Binding DeleteUserCommand}" Margin="0,0,5,0" Style="{StaticResource OutlinedButtonStyle}" Foreground="Red" BorderBrush="Red"/>
                        </StackPanel>

                        <TextBox Grid.Column="2" Width="200" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                 Tag="Search users..." VerticalContentAlignment="Center" Padding="5"/>
                    </Grid>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredUsers}" SelectedItem="{Binding SelectedUser}" 
                              AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="300"
                              SelectionMode="Single" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" IsReadOnly="True" Width="*"/>
                            <DataGridComboBoxColumn Header="Role" SelectedItemBinding="{Binding Role}" Width="120">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String">
                                        <sys:String>Admin</sys:String>
                                        <sys:String>Manager</sys:String>
                                        <sys:String>User</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                            <DataGridTextColumn Header="Last Login" Binding="{Binding LastLoginAt, StringFormat='{}{0:g}'}" IsReadOnly="True" Width="150"/>
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding IsActive, Converter={StaticResource ValidationResultConverter}}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding IsActive, Converter={StaticResource ValidationResultConverter}}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Expander>

            <!-- Login Screen Branding -->
            <Expander Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="Login Screen Branding" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <Label Content="Shop Name" Style="{StaticResource SettingLabelStyle}"/>
                    <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <CheckBox IsChecked="{Binding IsSpecialMessageEnabled}" Content="Enable Special Message" Margin="0,15,0,0"/>
                    
                    <Label Content="Special Message" Style="{StaticResource SettingLabelStyle}"/>
                    <TextBox Text="{Binding SpecialMessageText, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                    
                    <Label Content="Background Image" Style="{StaticResource SettingLabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LoginBackgroundPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFileCommand}" CommandParameter="LoginBackgroundPath" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Content="❌" Command="{Binding ClearImageCommand}" CommandParameter="LoginBackgroundPath" Margin="5,0,0,0" ToolTip="Clear Image"/>
                    </Grid>
                    <!-- Image Preview -->
                    <Border Margin="0,10,0,0" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Left" 
                            Visibility="{Binding LoginBackgroundPath, Converter={StaticResource ImagePreviewConverter}}">
                        <Image Source="{Binding LoginBackgroundPath, Converter={StaticResource ImagePreviewConverter}}" MaxHeight="150"/>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Shop Settings -->
            <Expander Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="Shop Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Left Column -->
                        <StackPanel Grid.Column="0">
                            <Label Content="Tattoo Rate ($/hr)" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding TattooRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                            <Label Content="Piercing Rate (Single)" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding PiercingSingle, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                            <Label Content="Shop Minimum Rate ($)" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding ShopMinimumRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            
                            <Label Content="Tax Rate (%)" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding TaxRate, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                        </StackPanel>
                        
                        <!-- Right Column -->
                        <StackPanel Grid.Column="2">
                            <Label Content="Deposit Type" Style="{StaticResource SettingLabelStyle}"/>
                            <ComboBox SelectedValue="{Binding DepositType}" SelectedValuePath="Content">
                                <ComboBoxItem Content="Percentage"/>
                                <ComboBoxItem Content="Fixed"/>
                            </ComboBox>

                            <Label Content="Deposit Amount" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>

                            <Label Content="Booking Buffer (Minutes)" Style="{StaticResource SettingLabelStyle}"/>
                            <TextBox Text="{Binding BookingBufferMinutes, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}"/>
                            
                            <Label Content="Appointment Duration Presets (Minutes)" Style="{StaticResource SettingLabelStyle}"/>
                            <ItemsControl ItemsSource="{Binding AppointmentDurationPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource SurfaceAltBrush}" CornerRadius="4" Margin="0,0,5,5" Padding="5,2" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                <Button Content="×" Command="{Binding DataContext.RemoveDurationPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                        CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="2,0" Foreground="Red" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding NewDurationPreset, UpdateSourceTrigger=PropertyChanged}" Tag="Add preset (min)..."/>
                                <Button Grid.Column="1" Content="+" Command="{Binding AddDurationPresetCommand}" Margin="5,0,0,0" Width="30"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Label Content="Cancellation Policy" Style="{StaticResource SettingLabelStyle}"/>
                    <TextBox Text="{Binding CancellationPolicy, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" AcceptsReturn="True"/>

                    <Label Content="Sidebar Artwork" Style="{StaticResource SettingLabelStyle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SidebarArtworkPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFileCommand}" CommandParameter="SidebarArtworkPath" Margin="10,0,0,0"/>
                        <Button Grid.Column="2" Content="❌" Command="{Binding ClearImageCommand}" CommandParameter="SidebarArtworkPath" Margin="5,0,0,0" ToolTip="Clear Image"/>
                    </Grid>
                    <!-- Image Preview -->
                    <Border Margin="0,10,0,0" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" HorizontalAlignment="Left" 
                            Visibility="{Binding SidebarArtworkPath, Converter={StaticResource ImagePreviewConverter}}">
                        <Image Source="{Binding SidebarArtworkPath, Converter={StaticResource ImagePreviewConverter}}" MaxHeight="150"/>
                    </Border>
                </StackPanel>
            </Expander>

            <!-- Shop Hours -->
            <Expander Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="Shop Hours" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding ShopHours}" Margin="10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DayName}" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" FontWeight="Medium"/>
                                <CheckBox IsChecked="{Binding IsOpen}" Content="Open" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="2" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedStartTime}" Width="100" Margin="5,0"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}" Margin="5,0"/>
                                    <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedEndTime}" Width="100" Margin="5,0"/>
                                </StackPanel>
                                <Button Grid.Column="3" Content="Copy to All" Command="{Binding DataContext.CopyToAllDaysCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="10,0,0,0" Style="{StaticResource OutlinedButtonStyle}" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Copy these hours to all other days"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>

            <!-- Special Hours & Holidays -->
            <Expander Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="Special Hours &amp; Holidays" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Calendar -->
                    <Calendar SelectedDate="{Binding SelectedSpecialDate}" Margin="0,0,20,0" VerticalAlignment="Top"/>
                    
                    <!-- Settings -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding SelectedSpecialDate, StringFormat='{}{0:D}'}" FontWeight="Bold" Margin="0,0,0,10"/>
                        
                        <CheckBox IsChecked="{Binding IsSpecialDayClosed}" Content="Closed all day" Margin="0,0,0,10"/>
                        
                        <Label Content="Description (e.g., 'Christmas')" Style="{StaticResource SettingLabelStyle}"/>
                        <TextBox Text="{Binding SpecialDayDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                        
                        <Button Content="Add/Update Special Day" Command="{Binding AddSpecialDayCommand}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,0,20"/>
                        
                        <TextBlock Text="Upcoming Special Days" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <DataGrid ItemsSource="{Binding SpecialHours}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:d}'}" IsReadOnly="True" Width="100"/>
                                <DataGridCheckBoxColumn Header="Closed" Binding="{Binding IsClosed}" IsReadOnly="True" Width="60"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="❌" Command="{Binding DataContext.RemoveSpecialDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource OutlinedButtonStyle}" BorderThickness="0" Foreground="Red"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Grid>
            </Expander>

            <!-- Application Settings -->
            <Expander Margin="0,0,0,10">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Header, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}, Converter={StaticResource HeaderIconConverter}}" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="Application Settings" Style="{StaticResource SectionHeaderStyle}" Margin="0"/>
                    </StackPanel>
                </Expander.Header>
                <StackPanel Margin="10">
                    <CheckBox IsChecked="{Binding EnableHolidayThemes}" Content="Enable automatic holiday themes"/>
                </StackPanel>
            </Expander>

            <Button Content="Save All Settings" Command="{Binding SaveSettingsCommand}" Margin="0,20,0,0" HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Padding="20,10"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
