<UserControl x:Class="InfernalInkSteelSuite.Views.Settings.AdminTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:InfernalInkSteelSuite.Views.Settings"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <GroupBox Header="User Management" Margin="0,0,0,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10">
                        <Button Content="Add User" Command="{Binding AddUserCommand}" Margin="5"/>
                        <Button Content="Update Role" Command="{Binding UpdateRoleCommand}" Margin="5"/>
                        <Button Content="Reset Password" Command="{Binding ResetPasswordCommand}" Margin="5"/>
                    </StackPanel>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" CanUserAddRows="False" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Username" Binding="{Binding Username}" IsReadOnly="True" Width="*"/>
                            <DataGridComboBoxColumn Header="Role" SelectedItemBinding="{Binding Role}" Width="*">
                                <DataGridComboBoxColumn.ItemsSource>
                                    <x:Array Type="sys:String">
                                        <sys:String>Admin</sys:String>
                                        <sys:String>Manager</sys:String>
                                        <sys:String>User</sys:String>
                                    </x:Array>
                                </DataGridComboBoxColumn.ItemsSource>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Header="Login Screen Branding" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Label Content="Shop Name" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding ShopName, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox IsChecked="{Binding IsSpecialMessageEnabled}" Content="Enable Special Message" Margin="0,10,0,0"/>
                    <Label Content="Special Message" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding SpecialMessageText, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Background Image Path" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LoginBackgroundPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFileCommand}" CommandParameter="LoginBackgroundPath" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Shop Settings" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <Label Content="Tattoo Rate Per Hour" Foreground="{DynamicResource TextColor}"/>
                    <TextBox Text="{Binding TattooRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Piercing Rate" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding PiercingSingle, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Shop minimum rate ($)" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                    <TextBox Text="{Binding ShopMinimumRate, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Sidebar Artwork" Foreground="{DynamicResource TextColor}" Margin="0,10,0,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding SidebarArtworkPath, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True"/>
                        <Button Grid.Column="1" Content="Browse..." Command="{Binding BrowseFileCommand}" CommandParameter="SidebarArtworkPath" Margin="10,0,0,0"/>
                    </Grid>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Shop Hours" Margin="0,0,0,10">
                <GroupBox.Resources>
                    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
                </GroupBox.Resources>
                <ItemsControl ItemsSource="{Binding ShopHours}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding DayName}" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <CheckBox IsChecked="{Binding IsOpen}" Content="Open" Margin="10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                <StackPanel Orientation="Horizontal" Grid.Column="2" Visibility="{Binding IsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedStartTime}" Width="100" Margin="5,0"/>
                                    <TextBlock Text="to" VerticalAlignment="Center" Foreground="{DynamicResource TextColor}"/>
                                    <ComboBox ItemsSource="{Binding TimeSlots}" SelectedItem="{Binding SelectedEndTime}" Width="100" Margin="5,0"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </GroupBox>

            <GroupBox Header="Application Settings" Margin="0,0,0,10">
                <StackPanel Margin="10">
                    <CheckBox IsChecked="{Binding EnableHolidayThemes}" Content="Enable automatic holiday themes"/>
                </StackPanel>
            </GroupBox>

            <Button Content="Save Settings" Command="{Binding SaveSettingsCommand}" Margin="0,20,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
