<UserControl x:Class="InfernalInkSteelSuite.Views.Appointments.UpcomingAppointmentsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <DataGrid x:Name="UpcomingAppointmentsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Client" Binding="{Binding ClientName}" />
                <DataGridTextColumn Header="Date" Binding="{Binding DateTime, StringFormat='{}{0:MM/dd/yyyy}'}" />
                <DataGridTextColumn Header="Time" Binding="{Binding DateTime, StringFormat='{}{0:hh:mm tt}'}" />
                <DataGridTextColumn Header="Service" Binding="{Binding ServiceType}" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
