<UserControl x:Class="InfernalInkSteelSuite.Controls.PasswordBoxWithToggle"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:InfernalInkSteelSuite.Converters"
             x:Name="Root">
    <UserControl.Resources>
        <converters:EyeIconConverter x:Key="EyeIconConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <!-- The actual password entry (masked) -->
        <PasswordBox x:Name="PwdBox"
                     Padding="5"
                     FontSize="14"
                     VerticalContentAlignment="Center"
                     PasswordChanged="PwdBox_PasswordChanged"/>

        <!-- Plain-text overlay – hidden by default -->
        <TextBox x:Name="TxtBox"
                 Visibility="Collapsed"
                 Padding="5"
                 FontSize="14"
                 VerticalContentAlignment="Center"
                 TextChanged="TxtBox_TextChanged"/>

        <!-- Eye-icon button -->
        <Button x:Name="ToggleBtn"
                Width="30" 
                Height="30"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,5,0"
                Background="Transparent"
                BorderThickness="0"
                Cursor="Hand"
                Click="ToggleBtn_OnClick">
            <Image Width="20" 
                   Height="20"
                   Source="{Binding IsPasswordVisible, ElementName=Root, Converter={StaticResource EyeIconConverter}}"/>
        </Button>
    </Grid>
</UserControl>

