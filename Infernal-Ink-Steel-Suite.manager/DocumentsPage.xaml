<Page x:Class="Infernal_Ink_Steel_Suite.manager.DocumentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="DocumentsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
            <Button Content="Add Document" Margin="5" Click="AddDocumentButton_Click"/>
            <Button Content="Refresh" Margin="5" Click="RefreshButton_Click"/>
            <TextBox x:Name="FilterInput" Width="200" Margin="5"/>
            <Button Content="Filter" Margin="5" Click="FilterButton_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="1" x:Name="DocumentsGrid" AutoGenerateColumns="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="File Name" Binding="{Binding Title}"/>
                <DataGridTextColumn Header="Client ID" Binding="{Binding ClientId}"/>
                <DataGridTextColumn Header="Date Added" Binding="{Binding CreatedAt}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
